+++++++  let numChunks = (count + wg - 1u) / wg;
+++++++  if (tid == 0u) { carry = 0u; }
+++++++  workgroupBarrier();
+++++++  for (var ch = 0u; ch < numChunks; ch = ch + 1u) {
