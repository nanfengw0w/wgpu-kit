+++++-  sensorAngle?: number;   // 触须张角(弧度),默认 0.5
+++++-  sensorDist?: number;    // 感知距离(世界单位),默认 0.012
+++++-  turnAngle?: number;     // 每帧最大转向,默认 0.45
+++++-  step?: number;          // 每帧移动距离,默认 0.003
+++++-  decay?: number;         // 每帧衰减比例 0..1,默认 0.06
+++++-  seed?: string | number;
+++++-  colormap?: 'amber' | 'ice' | 'duotone' | 'mono';
