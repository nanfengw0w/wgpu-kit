+++++++-      let s = at(x + dx, y + dy);
+++++++-      let wgt = select(0.05, 0.2, dx == 0 || dy == 0);
+++++++-      lapA = lapA + wgt * s.x;
+++++++-      lapB = lapB + wgt * s.y;
+++++++-    }
