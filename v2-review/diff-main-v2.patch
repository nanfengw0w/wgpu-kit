+++    },
+++
+++    endSubmit(): void {
+++      guardOpen = false;
+++    },
+++
+++    resetEncodeGuard(): void {
+++      guardArmed = false;
+++    },
+++
+++    destroy(): void {
+++      params?.destroy();
+++      pipelines = null;
+++      guardOpen = false;
+++    },
+++  };
+++}
