++++++++    let i = ch * wg + tid;
++++++++    let inRange = i < count;
++++++++    let v = select(0u, src[i], inRange);
++++++++    partial[tid] = v;
++++++++    workgroupBarrier();
++++++++    var offset = 1u;
++++++++    loop {
++++++++      if (offset >= wg) { break; }
++++++++      var x = 0u;
++++++++      if (tid >= offset) { x = partial[tid - offset]; }
++++++++      workgroupBarrier();
++++++++      if (tid >= offset) { partial[tid] = partial[tid] + x; }
