+++++++-export function mapFragment(colormap: Colormap): string {
+++++++-  return /* wgsl */ `
+++++++-struct VsOut {
+++++++-  @builtin(position) pos: vec4f,
+++++++-  @location(0) uv: vec2f,
+++++++-};
+++++++-@group(0) @binding(0) var<uniform> vp: vec4f; // w, h, maxV, gamma
