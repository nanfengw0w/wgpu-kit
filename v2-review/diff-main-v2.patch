+++++-  if (i >= params.count) { return; }
+++++-  let segs = params.segments;
+++++-  let k = i % segs;
+++++-  let chain = i / segs;
+++++-  if (k == 0u) {
+++++-    let anchor = anchorPos(chain, params.time);
+++++-    posOut[i] = anchor;
+++++-    prev[i] = anchor;
+++++-    return;
+++++-  }
