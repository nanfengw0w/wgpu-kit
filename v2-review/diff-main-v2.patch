-    coh = coh / nf - myPos;
-    vel = myVel + (sep * params.wSep + ali * params.wAli + coh * params.wCoh) * 0.016;
-  }
-  let sp = length(vel);
-  if (sp > params.maxSpeed) { vel = vel / sp * params.maxSpeed; }
