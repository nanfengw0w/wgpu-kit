++++++++  partial[tid] = local;
++++++++  workgroupBarrier();
++++++++  var offset = 1u;
++++++++  loop {
++++++++    if (offset >= ${WG}u) { break; }
++++++++    var x = 0u;
++++++++    if (tid >= offset) { x = partial[tid - offset]; }
++++++++    workgroupBarrier();
++++++++    if (tid >= offset) { partial[tid] = partial[tid] + x; }
++++++++    workgroupBarrier();
++++++++    offset = offset << 1u;
