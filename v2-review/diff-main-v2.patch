+++-  let jitter = (f32((i * 2654435761u + 1u) % 100u) / 100.0 - 0.5) * 0.1;
+++-  if (fwd > left && fwd > right) {
+++-    // 直行
+++-  } else if (left > right) {
+++-    a = a - params.turnAngle;
+++-  } else if (right > left) {
+++-    a = a + params.turnAngle;
+++-  }
+++-  a = a + jitter * 0.1;
