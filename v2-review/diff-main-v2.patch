++  endSubmit(): void;
++  /** 高级:解除 encode-once 检测(自行承担参数覆盖语义) */
++  resetEncodeGuard(): void;
++  /** 便捷路径:内部 encoder + 提交 */
++  run(src: Buffer, dst: Buffer, count: number, exclusive?: boolean): Promise<void>;
++  destroy(): void;
++}
