+++++++-fn at(x: i32, y: i32) -> vec2f {
+++++++-  let w = i32(params.w);
+++++++-  let h = i32(params.h);
+++++++-  let xi = (x + w) % w;
+++++++-  let yi = (y + h) % h;
+++++++-  return src[u32(yi) * u32(w) + u32(xi)];
