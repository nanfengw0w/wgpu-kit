++-| { op: 'blur', radius? } | radius 1..4,默认 1 | 盒式模糊 |
++-| { op: 'sharpen', amount? } | amount 默认 1 | 3×3 锐化 |
++-| { op: 'brightness', value } | −1..1 | 亮度 |
++-| { op: 'contrast', value } | 0..2,1=不变 | 对比度 |
