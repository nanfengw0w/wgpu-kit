+++++-  let i = gid.x;
+++++-  if (i >= params.count) { return; }
+++++-  let segs = params.segments;
+++++-  let k = i % segs;
+++++-  if (k == 0u) { posOut[i] = posIn[i]; return; }
+++++-  let d = posIn[i] - posIn[i - 1u];
+++++-  let l = length(d) + 1e-6;
+++++-  posOut[i] = posIn[i - 1u] + d / l * params.segLen;
