+++++++-  if (fwd > left && fwd > right) {
+++++++-    // 直行
+++++++-  } else if (left > right) {
+++++++-    a = a - params.turnAngle;
+++++++-  } else if (right > left) {
+++++++-    a = a + params.turnAngle;
+++++++-  }
