+++-@vertex
+++-fn vs(@builtin(vertex_index) v: u32) -> VsOut {
+++-  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
+++-  var out: VsOut;
+++-  out.pos = vec4f(p[v], 0.0, 1.0);
+++-  out.uv = (p[v] + vec2f(1.0)) * 0.5;
