++++++++@group(0) @binding(1) var<storage, read> src: array<u32>;
++++++++@group(0) @binding(2) var<storage, read_write> dst: array<atomic<u32>>;
++++++++
++++++++var<workgroup> partial: array<u32, ${WG}>;
