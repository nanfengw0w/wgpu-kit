+++++++-    var n = 0.0;
+++++++-    for (var dy = -2; dy <= 2; dy++) {
+++++++-      for (var dx = -2; dx <= 2; dx++) {
+++++++-        s = s + textureSample(tex, samp, i.uv + vec2f(f32(dx), f32(dy)) * e * 0.6).rgb;
+++++++-        n = n + 1.0;
+++++++-      }
+++++++-    }
+++++++-    return vec4f(s / n, 1.0);
+++++++-  }
