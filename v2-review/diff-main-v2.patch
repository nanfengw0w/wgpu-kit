+++-  if (i >= params.count) { return; }
+++-  let p = pos[i];
+++-  var a = ang[i];
+++-
+++-  let fwd = sense(p, a);
+++-  let left = sense(p, a - params.sensorAngle);
+++-  let right = sense(p, a + params.sensorAngle);
