-function agentWgsl(trailW: number): string {
-  return /* wgsl */ `
-const TRAIL_W: u32 = ${trailW}u;
-const TRAIL_MASK: u32 = ${trailW - 1}u;
-struct Params {
-  count: u32, _pad: u32,
-  sensorAngle: f32, sensorDist: f32, turnAngle: f32, step: f32,
-  deposit: f32, worldHalf: f32,
