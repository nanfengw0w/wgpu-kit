+++++++-  }
+++++++-  // contrast
+++++++-  let g = vec3f(0.5);
+++++++-  return vec4f(clamp(g + (c - g) * u.value, vec3f(0.0), vec3f(1.0)), 1.0);
+++++++-}
+++++++-`;
+++++++-}
