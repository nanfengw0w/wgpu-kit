+++++++  let numChunks = (count + wg - 1u) / wg;
+++++++  if (tid == 0u) { carry = 0u; }
+++++++  workgroupBarrier();
+++++++  for (var ch = 0u; ch < numChunks; ch = ch + 1u) {
+++++++    let i = ch * wg + tid;
+++++++    let inRange = i < count;
+++++++    let v = select(0u, blockSums[i], inRange);
+++++++    partial[tid] = v;
