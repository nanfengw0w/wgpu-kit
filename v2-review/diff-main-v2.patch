++      p1.setBindGroup(0, device.createBindGroup({
++        layout: pipelines.pReduce.getBindGroupLayout(0),
++        entries: [
++          { binding: 0, resource: { buffer: params } },
++          { binding: 1, resource: { buffer: src } },
++          { binding: 2, resource: { buffer: dst } },
++        ],
