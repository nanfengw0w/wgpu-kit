+-  let phase = f32(chain) * 2.399963; // 黄金角:链与链永不重叠排布
+-  let x = cos(t * 0.7 + phase) * params.anchorR;
+-  let y = sin(t * 1.13 + phase * 1.7) * params.anchorR * 0.55;
+-  return vec2f(x, y);
