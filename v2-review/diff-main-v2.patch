+++++++-  var out: VsOut;
+++++++-  out.pos = vec4f(p[v], 0.0, 1.0);
+++++++-  out.uv = (p[v] + vec2f(1.0)) * 0.5;
+++++++-  out.uv = vec2f(out.uv.x, 1.0 - out.uv.y); // buffer 行 0 = 画面顶部
