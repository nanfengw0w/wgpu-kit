++// —— 单档:单 workgroup 分块循环(carry 串接),dispatch(1) ——
++@compute @workgroup_size(${WG})
++fn scan_single(@builtin(local_invocation_id) lid: vec3u) {
++  let tid = lid.x;
++  let wg = ${WG}u;
++  let count = params.count;
++  let numChunks = (count + wg - 1u) / wg;
++  if (tid == 0u) { carry = 0u; }
