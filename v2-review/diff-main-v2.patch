+-  let k = i % segs;
+-  let chain = i / segs;
+-  if (k == 0u) {
+-    let anchor = anchorPos(chain, params.time);
+-    posOut[i] = anchor;
+-    prev[i] = anchor;
+-    return;
+-  }
+-  let vel = (posIn[i] - prev[i]) * params.damping;
+-  prev[i] = posIn[i];
+-  posOut[i] = posIn[i] + vel + vec2f(0.0, -params.gravity);
