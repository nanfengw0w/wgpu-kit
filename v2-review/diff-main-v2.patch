+++++++    async sum(src: Buffer, count: number): Promise<number> {
+++++++      await this.prepare();
+++++++      const device = ctx!.device;
+++++++      const enc = device.createCommandEncoder();
+++++++      this.sumInto(enc, src.gpuBuffer, count, dstBuf!);
