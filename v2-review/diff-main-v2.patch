++++++++  let tid = lid.x;
++++++++  let segBase = wid.x * ${WG * ITEMS}u;
++++++++  var local = 0u;
++++++++  for (var j = 0u; j < ${ITEMS}u; j = j + 1u) {
++++++++    let i = segBase + j * ${WG}u + tid;
++++++++    if (i < params.count) { local = local + src[i]; }
